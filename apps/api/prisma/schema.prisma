generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attempts     Attempt[]
  mistakes     Mistake[]
  reviewItems  ReviewItem[]
}

model LessonCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  createdAt   DateTime @default(now())
  lessons     Lesson[]
}

model Lesson {
  id         Int            @id @default(autoincrement())
  categoryId Int
  title      String
  level      String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  category   LessonCategory @relation(fields: [categoryId], references: [id])
  phrases    LessonPhrase[]
  attempts   Attempt[]

  @@index([categoryId])
}

model LessonPhrase {
  id          Int      @id @default(autoincrement())
  lessonId    Int
  expected    String
  translation String
  tags        String[] @default([])
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  attempts    Attempt[]
  mistakes    Mistake[]
  reviewItems ReviewItem[]

  @@index([lessonId])
  @@unique([lessonId, order])
}

model Attempt {
  id          Int      @id @default(autoincrement())
  userId      Int
  lessonId    Int
  phraseId    Int
  expectedText String
  transcript  String
  confidence  Float
  score       Int
  missing     String[] @default([])
  extra       String[] @default([])
  createdAt   DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id])
  lesson Lesson      @relation(fields: [lessonId], references: [id])
  phrase LessonPhrase @relation(fields: [phraseId], references: [id])

  @@index([userId, createdAt])
  @@index([phraseId])
  @@index([lessonId])
}

model Mistake {
  id        Int      @id @default(autoincrement())
  userId    Int
  phraseId  Int
  word      String
  count     Int      @default(1)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id])
  phrase LessonPhrase @relation(fields: [phraseId], references: [id])

  @@unique([userId, phraseId, word])
  @@index([userId, lastSeen])
}

model ReviewItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  phraseId    Int
  dueDate     DateTime @default(now())
  easeFactor  Float    @default(2.5)
  intervalDays Int     @default(1)
  repetitions Int      @default(0)
  lastReviewedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id])
  phrase LessonPhrase @relation(fields: [phraseId], references: [id])

  @@unique([userId, phraseId])
  @@index([userId, dueDate])
}
