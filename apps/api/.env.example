PORT=3001
DATABASE_URL="postgresql://emc:emc@localhost:5432/emc?schema=public"

JWT_ACCESS_SECRET="access_secret_dev__change_me_please"
JWT_REFRESH_SECRET="refresh_secret_dev__change_me_please"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Mock provider toggles (set to false to use real providers)
MOCK_STT=true
MOCK_TTS=true
MOCK_LLM=true

# Provider selection (real providers are scaffolded but not implemented yet)
STT_PROVIDER=not_configured
TTS_PROVIDER=not_configured
LLM_PROVIDER=not_configured

# Uploads (dev default is inside the repo; prod should be a writable volume like /data/uploads)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=12

# CORS (comma-separated). For Expo dev, you can leave empty.
# Example: CORS_ORIGINS="http://localhost:19006,http://localhost:8081"
CORS_ORIGINS=
TRUST_PROXY=false

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Optional (recommended in production): REDIS_URL="redis://localhost:6379"
REDIS_URL=

# Logging
LOG_LEVEL=info
